# Copy this file to .env.local and fill it in. See README.md.

# Claude API key, from the Claude Console. Needed for reading photos and for
# "find my page". Everything else works without it.
ANTHROPIC_API_KEY=

# Optional. Folder where the app keeps its JSON data (default: ./data).
# DATA_DIR=/var/lib/bookmarker

# Optional. Set to false to stop new people from creating accounts.
# ALLOW_SIGNUPS=false

# Optional. AI requests each signed-in user may make per day (default 60).
# AI_DAILY_LIMIT=60

# Optional. Only if you serve the built app over plain http:// on a network
# address (not localhost): lets the sign-in cookie work without https.
# INSECURE_COOKIES=true

# Optional. Use different Claude models.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
