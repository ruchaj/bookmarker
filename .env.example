# Copy this file to .env.local and fill it in. See README.md for where each value comes from.

# Supabase: Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxx

# Claude API key, from the Claude Console. Server-side only; never prefix it with NEXT_PUBLIC_.
ANTHROPIC_API_KEY=

# Optional. AI requests each signed-in user may make per day (default 60).
# AI_DAILY_LIMIT=60

# Optional. Use different Claude models.
# ANTHROPIC_MODEL=claude-sonnet-5-5
# ANTHROPIC_FAST_MODEL=claude-haiku-5-5
